# The maintainer's backlog: kept locally, out of the public repo. On their machine this
# is a symlink into Dropbox (the central backlog folder), hence no trailing slash.
/backlog

# local-only tests, eg against private endpoints (see docs/pages/tests.md)
ontospy/tests/local/

# setuptools' sdist staging folder, eg ontospy-2.2/ (it can survive builds inside Dropbox)
/ontospy-*/
ontospy-*/
